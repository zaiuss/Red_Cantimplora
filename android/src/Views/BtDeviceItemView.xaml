<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cantimplora.Views.BtDeviceItemView"
             x:Name="Root">
    <!-- item: nombre+MAC y botón conectar -->
    <Grid ColumnDefinitions="*,Auto" Padding="8">
        <VerticalStackLayout Grid.Column="0">
            <Label Text="{Binding Name}" FontAttributes="Bold" />
            <Label Text="{Binding MacAddress}" FontSize="12" TextColor="Gray" />
        </VerticalStackLayout>
        <Button Grid.Column="1" Text="Conectar" Command="{Binding ConnectCommand, Source={x:Reference Root}}" CommandParameter="{Binding MacAddress}" />
    </Grid>
</ContentView>
