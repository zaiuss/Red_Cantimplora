<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cantimplora.Views.ActiveLinkView"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,10,10">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto">
            <Label Grid.Row="0" Text="{Binding ConnectedName, Source={x:Reference Root}, StringFormat='{0}'}" FontSize="20" TextColor="{StaticResource DarkBorder}" Margin="0,10,0,0" HorizontalOptions="Center" />
            <HorizontalStackLayout Grid.Row="1" Margin="0,0,0,0" Spacing="4" HorizontalOptions="Center">
                <Label Text="{Binding MacAddress, Source={x:Reference Root}, StringFormat='MAC: {0}'}" FontSize="11" TextColor="Black" Margin="0,4,0,0"/>
                <Label Text="{Binding Esp32Id, Source={x:Reference Root}, StringFormat=' ID: {0}'}" FontSize="11" TextColor="Black" Margin="0,4,0,0"/>
            </HorizontalStackLayout>
        </Grid>
        <!-- switch espejo de IsConnected; re-emite Toggled al padre -->
        <Switch x:Name="InnerSwitch" Grid.Column="1" IsToggled="{Binding IsConnected, Source={x:Reference Root}, Mode=OneWay}" IsEnabled="{Binding IsConnected, Source={x:Reference Root}}" 
                Toggled="OnSwitchToggled" VerticalOptions="Center" Margin="0,6,14,0"/>
    </Grid>
</ContentView>
