<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cantimplora.Views.Esp32ComposerView"
             x:Name="Root">
    <!-- entry + enviar (Enter o botón) -->
    <Grid ColumnDefinitions="*,Auto">
        <Entry Grid.Column="0" Placeholder="Escribe un mensaje..." Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}" ReturnCommand="{Binding SendCommand, Source={x:Reference Root}}" />
        <Button Grid.Column="1" Text="Enviar" Command="{Binding SendCommand, Source={x:Reference Root}}" Margin="8,0,0,0" />
    </Grid>
</ContentView>
